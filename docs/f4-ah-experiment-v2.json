{
  "protocol_version": "f4-ah-research-v2",
  "declared_on": "2026-10-05",
  "scope": "all_EPL",
  "market": "90min_asian_handicap",
  "status": "exploratory_research_only",
  "decision_point": "earliest_valid_T-15m_per_match",
  "tolerance_minutes": 5,
  "split": {"unit": "UTC_Monday_week", "ratios": [0.6, 0.2, 0.2], "purge_unavailable_boundary_results": true},
  "minimum_matches": {"train": 120, "validation": 40, "test": 40},
  "candidate_ids": ["M1", "M2", "M3"],
  "training_objective": "regularized_five_class_settlement_log_loss",
  "regularization_grid": [0.1, 1.0, 10.0],
  "validation_primary_metric": "positive_return_direction_hit_rate",
  "direction_rule": "largest_full_win_plus_half_win_probability; home_on_ties",
  "push_in_hit_denominator": true,
  "probability_guardrails": {
    "reference": "lowest_validation_log_loss_model_in_same_candidate_regularization_grid",
    "maximum_absolute_deterioration": {"log_loss": 0.01, "brier": 0.02, "settlement_rps": 0.005},
    "tie_rule": "lowest_log_loss_then_grid_order",
    "tolerances_are_exploratory_not_empirically_optimal": true
  },
  "settlement_order": ["full_win", "half_win", "push", "half_loss", "full_loss"],
  "settlement_rps": "mean_over_matches_of_sum_of_four_cumulative_squared_errors_divided_by_four",
  "diagnostics": {"positive_return_probability_thresholds": [0.55, 0.60, 0.65], "minimum_model_side_ev": 0.0},
  "baseline": "lower_decimal_price_direction_heuristic_on_identical_selected_fixtures",
  "baseline_is_not_identified_five_class_market_probability": true,
  "comparisons": "candidate_pairwise_and_all_candidate_common_test_intersections; saved_forecasts_on_identical_contracts",
  "uncertainty": {"method": "paired_UTC_week_cluster_bootstrap", "samples": 2000, "seed": 0, "confidence": 0.95, "exploratory": true},
  "movement": {"require_same_company_source_URL_host_selection_policy": true, "require_observed_earlier_current_contract_price": true, "main_line_change_requires_both_certificates": true},
  "M2_minimum_prior_observed_results_per_team": 5,
  "monthly_outputs_are_repeated_development_not_fresh_confirmation": true,
  "candidate_weight": 0,
  "automatic_promotion": false,
  "automatic_wagering": false,
  "notifications": "monthly_and_critical_only",
  "future_hypotheses_not_implemented": ["coherent_goal_margin_market_residual", "hierarchical_shrinkage", "lagged_xG_and_official_lineup_increment"]
}
